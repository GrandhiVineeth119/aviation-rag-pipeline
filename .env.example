# ── LLM Provider ──────────────────────────────────────────
# Options: "ollama" (local, no API key) | "openai" | "anthropic"
LLM_PROVIDER=ollama

# ── Ollama (LOCAL — no API key needed) ───────────────────
# Make sure Ollama is running:  ollama serve
# Make sure model is pulled:    ollama pull qwen2.5
OLLAMA_MODEL=qwen2.5
OLLAMA_BASE_URL=http://localhost:11434

# ── OpenAI (only if LLM_PROVIDER=openai) ─────────────────
# OPENAI_API_KEY=sk-YOUR-KEY-HERE
# OPENAI_MODEL=gpt-4o-mini

# ── Anthropic (only if LLM_PROVIDER=anthropic) ───────────
# ANTHROPIC_API_KEY=sk-ant-YOUR-KEY-HERE
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Embedding (always local, no API key needed) ───────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Retrieval tuning ──────────────────────────────────────
TOP_K=5
SIMILARITY_THRESHOLD=0.25

# ── Paths ─────────────────────────────────────────────────
DOCUMENTS_DIR=documents
VECTOR_STORE_DIR=vector_store
